# gRPC-web proxy in front of a lightwalletd instance.
# Browsers cannot speak raw gRPC — run ../../infra/run-testnet-proxy.sh
# to proxy the public testnet lightwalletd (testnet.zec.rocks:443) locally.
# The server uses the same endpoint to verify submitted transactions.
NEXT_PUBLIC_LIGHTWALLETD_PROXY=http://localhost:8080

# "test" (Zcash testnet) or "main"
NEXT_PUBLIC_ZCASH_NETWORK=test

# Signs builder session cookies. Required in production (a Workers secret,
# `npx wrangler secret put SESSION_SECRET`); development falls back to a
# fixed string so sessions survive a restart.
SESSION_SECRET=

# Builders and challenge completions live in Cloudflare D1. `next dev` runs
# against a local D1 instance automatically (bindings come from
# wrangler.jsonc, state persists under .wrangler/) — nothing to configure.
