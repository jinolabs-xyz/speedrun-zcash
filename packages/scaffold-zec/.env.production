# Baked into the client bundle at build time (NEXT_PUBLIC_*). The server
# reads LIGHTWALLETD_PROXY from Worker vars instead — see wrangler.jsonc.
# ChainSafe's proxy speaks grpc-web over HTTP/1.1 and sends CORS headers,
# which the browser wallet needs; testnet.zec.rocks offers neither.
NEXT_PUBLIC_LIGHTWALLETD_PROXY=https://zcash-testnet.chainsafe.dev
NEXT_PUBLIC_ZCASH_NETWORK=test
