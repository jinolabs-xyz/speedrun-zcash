node_modules/
.next/
out/
dist/
.env.local
.env*.local
*.log
.DS_Store
tsconfig.tsbuildinfo
next-env.d.ts

# Internal working notes and heavy build artifacts stay local
info/
# The wasm/js runtime stays out of git (57 MB, served from R2; rebuild via
# scripts/vendor-webzjs.sh) but CI needs the package manifest and type
# declarations, since package.json depends on file:./vendor/webzjs-wallet.
# Children are excluded rather than the directories themselves because git
# cannot re-include files under an excluded directory.
packages/scaffold-zec/vendor/*
!packages/scaffold-zec/vendor/webzjs-wallet
packages/scaffold-zec/vendor/webzjs-wallet/*
!packages/scaffold-zec/vendor/webzjs-wallet/package.json
!packages/scaffold-zec/vendor/webzjs-wallet/*.d.ts
.claude/
packages/scaffold-zec/public/webzjs/

# Local database
packages/scaffold-zec/.data/

# Cloudflare build and local state
packages/scaffold-zec/.open-next/
packages/scaffold-zec/.wrangler/
packages/scaffold-zec/.dev.vars
